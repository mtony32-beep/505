<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#F5F5F5">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🔌 API Tester" android:textSize="24sp" android:textStyle="bold"
        android:textColor="#6200EE" android:paddingBottom="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gap="8dp">
        <Spinner android:id="@+id/spinner_method" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_weight="1"/>
        <EditText android:id="@+id/et_url" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="3"
            android:hint="https://api.example.com" android:padding="12dp" android:background="#FFFFFF"/>
    </LinearLayout>
    <EditText android:id="@+id/et_body" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Request Body (JSON)..."
        android:padding="12dp" android:background="#FFFFFF" android:layout_marginTop="8dp"
        android:minLines="4"/>
    <Button android:id="@+id/btn_send" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📤 KIRIM REQUEST"
        android:backgroundTint="#6200EE" android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" android:padding="16dp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="16dp">
        <TextView android:id="@+id/tv_response" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="16dp"
            android:background="#FFFFFF" android:text="Response akan muncul di sini..."/>
    </ScrollView>
</LinearLayout>
