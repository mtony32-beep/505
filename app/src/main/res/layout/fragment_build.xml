<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#F5F5F5">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🔨 Build APK" android:textSize="24sp" android:textStyle="bold"
        android:textColor="#6200EE" android:paddingBottom="16dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="• Gradle: 8.5\n• CompileSdk: 34\n• MinSdk: 24\n• Output: app-debug.apk"
        android:padding="12dp" android:background="#E8F5E9" android:textSize="14sp"/>
    <Button android:id="@+id/btn_build" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="🔨 MULAI BUILD APK"
        android:backgroundTint="#FF9800" android:textColor="#FFFFFF"
        android:layout_marginTop="24dp" android:padding="16dp"/>
    <Button android:id="@+id/btn_download" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="📥 DOWNLOAD APK TERBARU"
        android:backgroundTint="#4CAF50" android:textColor="#FFFFFF"
        android:layout_marginTop="8dp" android:padding="16dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="16dp" android:background="#FFFFFF"
        android:layout_marginTop="16dp" android:text="📋 Cara:\n1. Klik Mulai Build\n2. Buka GitHub → Actions\n3. Tunggu ±3 menit\n4. Download app-debug.apk di Artifacts"/>
</LinearLayout>
